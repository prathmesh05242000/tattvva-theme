<section class="sec"><div class="w" style="max-width:760px">{% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
{% for b in section.blocks %}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><p>{{ b.settings.a }}</p></details>{% endfor %}</div></section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading"}],
"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"q","label":"Question","default":"Question?"},{"type":"textarea","id":"a","label":"Answer"}]}],
"presets":[{"name":"FAQ","blocks":[{"type":"q"},{"type":"q"}]}]}
{% endschema %}
