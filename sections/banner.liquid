<section class="ph"><div class="w"><h1>{{ section.settings.heading | default: page.title }}</h1>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div></section>
{% schema %}
{"name":"Page banner","settings":[{"type":"text","id":"heading","label":"Heading (blank = page title)"},{"type":"textarea","id":"text","label":"Text"}],"presets":[{"name":"Page banner"}]}
{% endschema %}
