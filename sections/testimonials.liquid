          <div class="testi-stars">★★★★★</div>
          <span class="testi-verified"><span class="v-tick">✓</span> Verified Buyer</span>
        </div>
        <div class="testi-quote-mark" aria-hidden="true">“</div>
        <blockquote class="testi-quote">
