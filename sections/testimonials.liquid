{% capture single_group %}
  <div class="testi-marquee-group">
    {% if section.blocks.size > 0 %}
      {% for b in section.blocks %}
        <div class="testi-card" {{ b.shopify_attributes }}>
          <div class="testi-card-top">
            <div class="testi-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <span class="testi-verified"><span class="v-tick">✓</span> Verified Buyer</span>
          </div>
          <div class="testi-quote-mark" aria-hidden="true">“</div>
          <blockquote class="testi-quote">
            {{ b.settings.quote | default: b.settings.text }}
          </blockquote>
          {% if b.settings.detail != blank %}
            <p class="testi-detail">{{ b.settings.detail }}</p>
          {% endif %}
          <div class="testi-author">
            <div class="testi-avatar av-{{ forloop.index | modulo: 4 | plus: 1 }}">
              {{ b.settings.initials | default: 'TC' }}
            </div>
            <div class="testi-meta">
              <div class="testi-name">{{ b.settings.author | default: 'Tattvva Customer' }}</div>
              <div class="testi-role">{{ b.settings.location | default: 'Verified Family' }}{% if b.settings.product != blank %} &middot; {{ b.settings.product }}{% endif %}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- 6 default cards -->
      <div class="testi-card">
        <div class="testi-card-top">
          <div class="testi-stars">★★★★★</div>
          <span class="testi-verified"><span class="v-tick">✓</span> Verified Buyer</span>
        </div>
