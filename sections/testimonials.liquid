{% endcapture %}

<section class="sec testimonials-sec" id="testimonials">
  <div class="w">
    <!-- Header -->
    <div class="testi-header">
      <div class="testi-header-text">
        <span class="testi-badge">{{ section.settings.kicker | default: 'Customer Stories' }}</span>
        <h2 class="testi-heading">{{ section.settings.heading | default: 'Customer Testimonials' }}</h2>
        <p class="testi-subheading">{{ section.settings.subheading | default: 'Honest reviews from families embracing clean, mindful nutrition every day.' }}</p>
      </div>
    </div>

    <!-- Continuous Marquee Auto-scroller -->
    <div class="testi-marquee-wrap" id="testiMarqueeWrap">
      <div class="testi-marquee-track" id="testiTrack">
        {{ single_group }}
        {{ single_group }}
      </div>
    </div>

    <!-- Autoscroller status indicator -->
    <div class="testi-indicators">
      <div class="testi-live-pill">
        <span class="testi-pulse-dot" aria-hidden="true"></span>
        <span class="testi-status-text">Continuous Auto-scroller &middot; Hover or Tap to pause</span>
      </div>
    </div>

    <!-- Call to Action Banner -->
    <div class="testi-cta-banner">
      <div class="testi-cta-content">
        <span class="testi-cta-tag">{{ section.settings.cta_kicker | default: 'Call to Action' }}</span>
        <h3 class="testi-cta-title">{{ section.settings.cta_heading | default: 'Join thousands of customers choosing better nutrition with Tattvva.' }}</h3>
        <p class="testi-cta-subtext">{{ section.settings.cta_subtext | default: 'Handcrafted with 21 pure superfoods, slow-churned Desi ghee, and zero refined sugar.' }}</p>
        <div class="testi-social-proof">
          <div class="testi-avatar-stack">
            <span class="t-stk-av s1"></span>
            <span class="t-stk-av s2"></span>
            <span class="t-stk-av s3"></span>
            <span class="t-stk-av s4"></span>
          </div>
          <span class="testi-proof-text">★ 4.9/5 Average Rating &middot; Over 10,000+ Happy Families</span>
        </div>
      </div>
      <div class="testi-cta-action">
        <a href="{{ section.settings.cta_btn_url | default: '#products' }}" class="btn testi-cta-btn">
          {{ section.settings.cta_btn_text | default: 'Shop Now' }}
        </a>
        <span class="testi-cta-perk">⚡ Fast Dispatch &middot; 99.9% Quality Guarantee</span>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const sec = document.getElementById('testimonials');
      if(!sec) return;
      const wrap = sec.querySelector('#testiMarqueeWrap');
      if(!wrap) return;

      wrap.addEventListener('touchstart', function(){
        wrap.classList.add('is-paused');
      }, { passive: true });
      wrap.addEventListener('touchend', function(){
        wrap.classList.remove('is-paused');
      }, { passive: true });
    })();
  </script>
</section>

{% schema %}
{
