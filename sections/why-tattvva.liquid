<section class="sec why-tattvva-sec" id="why-tattvva">
  <div class="w">
    <div class="why-header">
      {% if section.settings.kicker != blank %}
        <span class="why-badge">{{ section.settings.kicker }}</span>
      {% endif %}
      <h2>{{ section.settings.heading | default: 'Why Choose Tattvva?' }}</h2>
      {% if section.settings.subtext != blank %}
        <p class="lead">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <!-- 3 Core Quality Pillars -->
    <!-- 3 Core Quality Pillars with Modern Apple-Style Card Stacking -->
    <div class="why-pillars-grid apple-card-stack" id="whyPillarsStack">
      <div class="why-card pillar-card stack-card" data-card-index="0">
        <div class="why-card-top">
          <div class="why-icon-badge gold-glow">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M12 2l2.9 6.2 6.8.9-5 4.8 1.3 6.8-6-3.3-6 3.3 1.3-6.8-5-4.8 6.8-.9L12 2z"/></svg>
          </div>
          <div class="why-card-top-right">
            <span class="stack-card-counter">01</span>
            <span class="why-tag tag-gold">✨ Finest Selection</span>
          </div>
        </div>
        <h3>Premium-Quality Ingredients</h3>
        <p>California almonds, Iranian pistachios, Medjool dates, and authentic Desi ghee.</p>
        <ul class="card-perks">
          <li><span class="chk">✓</span> California Almonds &amp; Pistas</li>
          <li><span class="chk">✓</span> Mineral-Rich Whole Dates</li>
          <li><span class="chk">✓</span> Slow-Churned Desi Ghee</li>
        </ul>
      </div>

      <div class="why-card pillar-card stack-card" data-card-index="1">
        <div class="why-card-top">
          <div class="why-icon-badge green-glow">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <div class="why-card-top-right">
            <span class="stack-card-counter">02</span>
            <span class="why-tag tag-green">🛡️ FSSAI Certified</span>
          </div>
        </div>
        <h3>Hygienically Prepared</h3>
        <p>Prepared in sanitized, climate-controlled environments with stringent batch traceability and lab testing.</p>
        <ul class="card-perks">
          <li><span class="chk">✓</span> FSSAI Certified Kitchen</li>
          <li><span class="chk">✓</span> Touchless Hygienic Packing</li>
          <li><span class="chk">✓</span> Lab Tested Batch Purity</li>
        </ul>
      </div>

      <div class="why-card pillar-card stack-card" data-card-index="2">
        <div class="why-card-top">
          <div class="why-icon-badge plum-glow">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <div class="why-card-top-right">
            <span class="stack-card-counter">03</span>
            <span class="why-tag tag-plum">🌟 Pure &amp; Fresh</span>
          </div>
        </div>
        <h3>Premium Packaging</h3>
        <p>Packed in elegant, food-grade premium packaging with golden caps to preserve freshness, taste, and nutrition.</p>
        <ul class="card-perks">
          <li><span class="chk">✓</span> Food-Grade Premium Packaging</li>
          <li><span class="chk">✓</span> Protective Lid Seal</li>
          <li><span class="chk">✓</span> Locks in 180-Day Freshness</li>
        </ul>
      </div>
    </div>

    <!-- The 5 Clean Recipe Zero-Nasties Guarantee -->
    <div class="why-nasties-banner">
      <div class="nasties-title">
        <span class="zero-badge">99.9% CLEAN PROMISE</span>
        <h4>Our Clean Recipe Guarantee</h4>
        <p>What we leave out is just as important as what we put in. Wholesome goodness for your entire family.</p>
      </div>
      <div class="nasties-grid">
        <div class="nasty-item">
          <div class="nasty-cross">✕</div>
          <div>
            <b>No Sugar No Jaggery</b>
            <span>Naturally sweetened only with whole dates &amp; fruits</span>
          </div>
        </div>
        <div class="nasty-item">
          <div class="nasty-cross">✕</div>
          <div>
            <b>No Preservatives</b>
            <span>Zero chemical additives or synthetic shelf-life extenders</span>
          </div>
        </div>
        <div class="nasty-item">
          <div class="nasty-cross">✕</div>
          <div>
            <b>No Artificial Additives</b>
            <span>Zero synthetic colors, flavors, binders, or essences</span>
          </div>
        </div>
        <div class="nasty-item nasty-item-positive">
          <div class="nasty-check">✓</div>
          <div>
            <b>Only All Natural Ingrediants</b>
            <span>99.9% whole fruits, premium nuts &amp; pure Desi ghee</span>
          </div>
        </div>
        <div class="nasty-item nasty-item-heart nasty-item-wide">
          <div class="nasty-heart">♥</div>
          <div>
            <b>Made with Love and Care</b>
            <span>Handcrafted fresh daily with ancestral care and mindful intention</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Ribbon -->
    <div class="why-trust-ribbon">
      <div class="trust-tick-item">
        <span class="tick">✔</span> No Sugar No Jaggery
      </div>
      <div class="trust-tick-item">
        <span class="tick">✔</span> No Preservatives
      </div>
      <div class="trust-tick-item">
        <span class="tick">✔</span> No Artificial Additives
      </div>
      <div class="trust-tick-item">
        <span class="tick">✔</span> Only All Natural Ingrediants
      </div>
      <div class="trust-tick-item">
        <span class="tick">✔</span> Made with Love and Care
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Tattvva",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small line / Subtitle",
      "default": "The Tattvva Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Tattvva?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Lead Description",
      "default": "Real nutrition crafted with zero compromises. Made with 21 pure superfoods and ancestral recipes to nourish your body everyday."
    }
  ],
  "presets": [
    {
      "name": "Why Choose Tattvva"
    }
  ]
}
{% endschema %}
