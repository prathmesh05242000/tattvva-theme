    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wholesome recipes, nutritional science, and mindful snacking rituals designed to nourish your body and mind with pure intention."
    }
  ],
  "presets": [
    {
      "name": "Conscious Journal"
    }
  ]
}
{% endschema %}
