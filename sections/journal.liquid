      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "CONSCIOUS COOKBOOK &amp; JOURNAL &middot; PURE INGREDIENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
