<section class="partner-hub-sec" id="distributors">
  <!-- Ambient Atmospheric Backlight -->
  <div class="ph-ambient-glow" aria-hidden="true"></div>
  
  <div class="w">
    
    <!-- Section Header -->
    <div class="ph-header">
      <div class="ph-kicker-wrap">
        <span class="ph-live-dot" aria-hidden="true"></span>
        <span class="ph-kicker">B2B &amp; RETAIL EXPANSION &middot; JOIN THE CLEAN FOOD REVOLUTION</span>
      </div>
      <h2 class="ph-title">{{ section.settings.heading | default: "Partner With <span class='ph-title-hl'>Tattvva</span>" }}</h2>
      <p class="ph-subtitle">{{ section.settings.text | default: "High partner margins, rapid inventory turns, and uncompromising 99.9% clean-label appeal. Expand your retail footprint, regional distribution, or corporate gifting catalog with India's rising superfood brand." }}</p>
    </div>

    <!-- MAIN TWO-COLUMN STAGE: Left Console + Right Inquiry Form -->
    <div class="ph-main-grid">
      
      <!-- LEFT: Dynamic Partnership Pathway Console -->
      <div class="ph-left-col">
        
        <!-- Interactive Vertical Switcher Tabs -->
        <div class="ph-switcher-label">SELECT YOUR PARTNERSHIP MODEL:</div>
        <div class="ph-pathway-tabs" role="tablist">
          <button class="ph-path-tab is-active" data-path="retail" type="button">
            <span class="ph-tab-icon">🏪</span>
            <div class="ph-tab-text">
              <b>Retail &amp; Modern Trade</b>
              <small>Supermarkets, Gourmet Stores &amp; Dry-Fruit Boutiques</small>
            </div>
            <span class="ph-tab-arrow">→</span>
          </button>

          <button class="ph-path-tab" data-path="distributor" type="button">
            <span class="ph-tab-icon">🚚</span>
            <div class="ph-tab-text">
              <b>Distributors &amp; Stockists</b>
              <small>Regional, City &amp; State-Exclusive Territories</small>
            </div>
            <span class="ph-tab-arrow">→</span>
          </button>

          <button class="ph-path-tab" data-path="corporate" type="button">
            <span class="ph-tab-icon">🎁</span>
            <div class="ph-tab-text">
              <b>Corporate &amp; Bulk Gifting</b>
              <small>Festive Diwali Hampers, Luxury Executive Curations</small>
            </div>
            <span class="ph-tab-arrow">→</span>
          </button>
        </div>

        <!-- Dynamic Opportunity Snapshot Screen -->
        <div class="ph-snapshot-screen" id="phSnapshotScreen">
          <div class="ph-snap-header">
            <span class="ph-snap-badge" id="phSnapBadge">RETAIL &amp; MODERN TRADE SPECIFICATION</span>
            <span class="ph-snap-active-tag">● READY FOR ONBOARDING</span>
          </div>

          <h3 class="ph-snap-title" id="phSnapTitle">Shelf-Ready Luxury Packaging with High Basket Value</h3>
          <p class="ph-snap-desc" id="phSnapDesc">Engineered specifically for premium gourmet shelves. Elegant premium packaging commands eye-level attention with a ₹999+ average transaction value, zero artificial preservatives, and an industry-leading 42% repeat purchase velocity.</p>

          <div class="ph-snap-perks" id="phSnapPerks">
            <div class="ph-perk-item">
              <span class="ph-perk-chk">✓</span>
              <div><b>25% Partner Margin (T&C)</b><small>Attractive ROI on premium shelf space</small></div>
            </div>
            <div class="ph-perk-item">
              <span class="ph-perk-chk">✓</span>
              <div><b>Marketing &amp; POP Collateral</b><small>Minimum cost counter displays, acrylic standees &amp; tasting kits</small></div>
            </div>
            <div class="ph-perk-item">
              <span class="ph-perk-chk">✓</span>
              <div><b>Zero Return Guarantee</b><small>6-month natural sealed shelf-stability</small></div>
            </div>
          </div>
        </div>

        <!-- Live Metrics Bar -->
        <div class="ph-live-stats-bar">
          <div class="ph-stat-node">
            <span class="ph-stat-val">25% T&C</span>
            <span class="ph-stat-lbl">Margin Potential</span>
          </div>
          <div class="ph-stat-div"></div>
          <div class="ph-stat-node">
            <span class="ph-stat-val">48h</span>
            <span class="ph-stat-lbl">Dispatch SLA</span>
          </div>
          <div class="ph-stat-div"></div>
          <div class="ph-stat-node">
            <span class="ph-stat-val">42%</span>
            <span class="ph-stat-lbl">Repeat Rate</span>
          </div>
          <div class="ph-stat-div"></div>
          <div class="ph-stat-node">
            <span class="ph-stat-val">99.9%</span>
            <span class="ph-stat-lbl">Clean Label</span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Modern Inquiry Engine -->
      <div class="ph-right-col">
        <div class="ph-form-card">
          <div class="ph-form-header">
            <div class="ph-form-icon">📋</div>
            <div>
              <h3 class="ph-form-title">Direct Partnership Desk</h3>
              <p class="ph-form-desc">Inquire today. Our commercial partnerships lead will respond within 4 business hours.</p>
            </div>
          </div>

          {% form 'contact', class: 'ph-form', id: 'partnerForm' %}
  {% if form.posted_successfully? %}
    <div class="ph-form-success" style="display:flex;">
      <span class="ph-ok-icon">✓</span>
      <div>
        <b>Inquiry Received Successfully!</b>
        <p>Our B2B trade desk has logged your request. We will connect with our product catalogue, wholesale price slab, and sampling terms shortly.</p>
      </div>
    </div>
  {% endif %}
  {% if form.errors %}
    <div class="ph-form-success" style="display:flex;border-color:#e63946;background:rgba(230,57,70,0.2);">
      <span class="ph-ok-icon" style="background:#e63946;">!</span>
      <div>
        <b>Please verify your details:</b>
        <p>{{ form.errors | default_errors }}</p>
      </div>
    </div>
  {% endif %}

  <input type="hidden" name="contact[tags]" value="b2b-distributor-enquiry">

  <div class="ph-field-row">
    <div class="ph-input-group">
      <label>Contact Name *</label>
      <input type="text" name="contact[name]" required placeholder="e.g. Rajesh Sharma" />
    </div>
    <div class="ph-input-group">
      <label>Company / Firm Name *</label>
      <input type="text" name="contact[company]" required placeholder="e.g. Organic Greens Mart" />
    </div>
  </div>

  <div class="ph-field-row">
    <div class="ph-input-group">
      <label>Email Address *</label>
      <input type="email" name="contact[email]" required placeholder="rajesh@example.com" />
    </div>
    <div class="ph-input-group">
      <label>Phone / WhatsApp *</label>
      <input type="tel" name="contact[phone]" required placeholder="+91 98765 43210" />
    </div>
  </div>

  <div class="ph-field-row">
    <div class="ph-input-group">
      <label>Partnership Model *</label>
      <select name="contact[partnership_type]" id="phSelectType" required>
        <option value="retail">Retail &amp; Modern Trade Store</option>
        <option value="distributor">Regional / City Distributor</option>
        <option value="corporate">Corporate / Bulk Gifting</option>
        <option value="export">International / Export Trade</option>
      </select>
    </div>
    <div class="ph-input-group">
      <label>Operating City &amp; State *</label>
      <input type="text" name="contact[location]" required placeholder="e.g. Mumbai, Maharashtra" />
    </div>
  </div>

  <div class="ph-input-group">
    <label>Monthly Volume / Business Brief</label>
    <textarea name="contact[body]" rows="3" placeholder="Tell us about your distribution footprint, expected volume, or gifting timeline..."></textarea>
  </div>

  <button class="ph-submit-btn" type="submit">
    <span>Submit Commercial Inquiry</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </button>

  <div class="ph-direct-strip">
    <span>Prefer instant trade chat?</span>
    <a class="ph-direct-link" href="https://wa.me/917666642122?text=Hello%2C%20I%20am%20interested%20in%20Tattvva%20partnership" target="_blank" rel="noopener">
      <span>💬 WhatsApp B2B Desk</span>
    </a>
    <a class="ph-direct-link" href="tel:+917666642122">
      <span>📞 +91 7666642122</span>
    </a>
  </div>
{% endform %}
        </div>
      </div>

    </div>

    <!-- THE PARTNER ADVANTAGE SLAB (Horizontal Minimalist Ribbon) -->
    <div class="ph-advantage-ribbon">
      <div class="ph-adv-item">
        <div class="ph-adv-icon">🛡️</div>
        <div>
          <b>Territory Exclusivity</b>
          <p>Protected pin-code mapping for regional super stockists.</p>
        </div>
      </div>
      <div class="ph-adv-item">
        <div class="ph-adv-icon">📦</div>
        <div>
          <b>Flexible Starter MOQs</b>
          <p>Low minimum batch orders to test velocity without inventory risk.</p>
        </div>
      </div>
      <div class="ph-adv-item">
        <div class="ph-adv-icon">🎨</div>
        <div>
          <b>Marketing &amp; POS Kit</b>
          <p>Minimum cost for branded acrylic counter racks, premium sampling packaging &amp; collateral.</p>
        </div>
      </div>
      <div class="ph-adv-item">
        <div class="ph-adv-icon">⚡</div>
        <div>
          <b>Seamless GST Compliance</b>
          <p>B2B invoice available for seamless GST compliance.</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Interactive JavaScript Logic -->
  <script>
    (function(){
      var modelData = {
        retail: {
          badge: 'RETAIL & MODERN TRADE SPECIFICATION',
          title: 'Shelf-Ready Luxury Packaging with High Basket Value',
          desc: 'Engineered specifically for premium gourmet shelves. Elegant premium packaging commands eye-level attention with a ₹999+ average transaction value, zero artificial preservatives, and an industry-leading 42% repeat purchase velocity.',
          perks: [
            { title: '25% Partner Margin (T&C)', sub: 'Attractive ROI on premium shelf space' },
            { title: 'Marketing & POP Collateral', sub: 'Minimum cost counter displays, acrylic standees & tasting kits' },
            { title: 'Zero Return Guarantee', sub: '6-month natural sealed shelf-stability' }
          ]
        },
        distributor: {
          badge: 'REGIONAL & CITY DISTRIBUTION SPECIFICATION',
          title: 'Protected Territory Exclusivity with Fast Pallet Turns',
          desc: 'Empowering master stockists across metropolitan and Tier-1 cities. Enjoy dedicated zonal distribution rights, centralized cold-chain fulfillment dispatch within 48 hours, and dedicated sales executive support.',
          perks: [
            { title: 'Protected Pincode Exclusivity', sub: 'No channel conflict or unauthorized third-party dumping' },
            { title: 'Centralized 48-Hour Dispatch SLA', sub: 'Fast restocking from state distribution hubs' },
            { title: 'Dedicated Field BDM Support', sub: 'Joint retail mapping and merchandising assistance' }
          ]
        },
        corporate: {
          badge: 'CORPORATE GIFTING & BULK CURATION SPECIFICATION',
          title: 'Bespoke Executive Packaging with Pan-India White-Glove Delivery',
          desc: 'Transform your brand gifting into an authentic wellness gesture. Handcrafted wooden and velvet gift boxes, laser-etched personalized sleeves, and direct multi-address doorstep courier dispatch across India.',
          perks: [
            { title: 'Custom Branded Sleeve & Inserts', sub: 'Incorporate corporate logo, personal letter & custom seals' },
            { title: 'Volume-Tiered Slab Discounts', sub: 'Attractive cost efficiencies for orders of 50 to 10,000+ units' },
            { title: 'Direct Pan-India Doorstep Drop', sub: 'End-to-end tracking to individual recipient homes' }
          ]
        }
      };

      var tabs = document.querySelectorAll('.ph-path-tab');
      var badge = document.getElementById('phSnapBadge');
      var title = document.getElementById('phSnapTitle');
      var desc = document.getElementById('phSnapDesc');
      var perksContainer = document.getElementById('phSnapPerks');
      var select = document.getElementById('phSelectType');
      var screen = document.getElementById('phSnapshotScreen');

      tabs.forEach(function(tab){
        tab.addEventListener('click', function(){
          tabs.forEach(function(t){ t.classList.remove('is-active'); });
          this.classList.add('is-active');
          var key = this.getAttribute('data-path');
          var data = modelData[key];
          if(!data) return;

          // Pulse animation on screen
          screen.classList.remove('ph-pulse');
          void screen.offsetWidth;
          screen.classList.add('ph-pulse');

          badge.textContent = data.badge;
          title.textContent = data.title;
          desc.textContent = data.desc;
          perksContainer.innerHTML = data.perks.map(function(p){
            return '<div class="ph-perk-item"><span class="ph-perk-chk">✓</span><div><b>' + p.title + '</b><small>' + p.sub + '</small></div></div>';
          }).join('');

          if(select) {
            select.value = key;
          }
        });
      });

      if(select) {
        select.addEventListener('change', function(){
          var val = this.value;
          var matchingTab = document.querySelector('.ph-path-tab[data-path="' + val + '"]');
          if(matchingTab) {
            matchingTab.click();
          }
        });
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Partner With Tattvva",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner With Tattvva"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "High partner margins, rapid inventory turns, and uncompromising 99.9% clean-label appeal. Expand your retail footprint, regional distribution, or corporate gifting catalog with India's rising superfood brand."
    }
  ],
  "presets": [
    {
      "name": "Partner With Tattvva"
    }
  ]
}
{% endschema %}
