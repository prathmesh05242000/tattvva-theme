                {% for img in roasted_prod.images %}
                  <div class="spotlight-thumb-item">
                    <button type="button" class="spotlight-thumb{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Shot {{ forloop.index }}"><img src="{{ img | image_url: width: 140 }}" width="60" height="60" alt="Thumbnail {{ forloop.index }}"></button>
