    <script>
    function handleNotify(btn, category) {
      btn.classList.add('is-notified');
      btn.innerHTML = '<span>✓</span> You’re on the VIP list!';
    }

    (function initProductTabs() {
      var tabs = document.querySelectorAll('.prod-tab');
      var cards = document.querySelectorAll('.spotlight-card');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var targetId = tab.getAttribute('data-target');
          tabs.forEach(function(t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');

          cards.forEach(function(card) {
            if (card.id === targetId) {
              card.classList.add('is-active');
            } else {
              card.classList.remove('is-active');
            }
          });
        });
      });
    })();

    // Luxury Product Gallery Slider & Lightbox Inspection
    (function initProductGalleries() {
      var galleries = document.querySelectorAll('.spotlight-gallery');
      var lightbox = document.getElementById('productLightbox');
      var lightboxImg = document.getElementById('lightboxImg');
      var lightboxCaption = document.getElementById('lightboxCaption');
      var lightboxClose = lightbox ? lightbox.querySelector('.tattvva-lightbox-close') : null;
      var lightboxPrev = lightbox ? lightbox.querySelector('.tattvva-lightbox-nav.prev') : null;
      var lightboxNext = lightbox ? lightbox.querySelector('.tattvva-lightbox-nav.next') : null;
      var currentGallery = null;
      var currentSlideIndex = 0;

      function openLightbox(gal, idx) {
        if (!lightbox) return;
        currentGallery = gal;
        var slides = gal.querySelectorAll('.spotlight-slide');
        if (!slides.length) return;
        currentSlideIndex = (idx >= 0 && idx < slides.length) ? idx : 0;
        updateLightboxSlide();
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function updateLightboxSlide() {
        if (!currentGallery || !lightboxImg) return;
        var slides = currentGallery.querySelectorAll('.spotlight-slide');
        var slide = slides[currentSlideIndex];
        if (!slide) return;
        var fullSrc = slide.getAttribute('data-full') || (slide.querySelector('img') ? slide.querySelector('img').src : '');
        var caption = slide.getAttribute('data-caption') || (slide.querySelector('.spotlight-slide-caption') ? slide.querySelector('.spotlight-slide-caption').textContent : '');
        lightboxImg.src = fullSrc;
        if (lightboxCaption) lightboxCaption.textContent = caption;
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      if (lightbox) {
        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', function(e) {
          if (e.target === lightbox) closeLightbox();
        });
        if (lightboxPrev) {
          lightboxPrev.addEventListener('click', function(e) {
            e.stopPropagation();
            if (!currentGallery) return;
            var slides = currentGallery.querySelectorAll('.spotlight-slide');
            currentSlideIndex = (currentSlideIndex - 1 + slides.length) % slides.length;
            updateLightboxSlide();
            if (currentGallery._goToSlide) currentGallery._goToSlide(currentSlideIndex);
          });
        }
        if (lightboxNext) {
          lightboxNext.addEventListener('click', function(e) {
            e.stopPropagation();
            if (!currentGallery) return;
            var slides = currentGallery.querySelectorAll('.spotlight-slide');
            currentSlideIndex = (currentSlideIndex + 1) % slides.length;
            updateLightboxSlide();
            if (currentGallery._goToSlide) currentGallery._goToSlide(currentSlideIndex);
          });
        }
        document.addEventListener('keydown', function(e) {
          if (!lightbox.classList.contains('is-open')) return;
          if (e.key === 'Escape') closeLightbox();
          else if (e.key === 'ArrowLeft' && lightboxPrev) lightboxPrev.click();
          else if (e.key === 'ArrowRight' && lightboxNext) lightboxNext.click();
        });
      }

      galleries.forEach(function(gal) {
        var slides = gal.querySelectorAll('.spotlight-slide');
        var thumbs = gal.querySelectorAll('.spotlight-thumb');
        var prevBtn = gal.querySelector('.spotlight-nav-btn.prev');
        var nextBtn = gal.querySelector('.spotlight-nav-btn.next');
        var zoomBtn = gal.querySelector('.spotlight-zoom-trigger');
        var counter = gal.querySelector('.runner-counter');
        var progress = gal.querySelector('.spotlight-progress-fill');
        var total = slides.length;
        if (total === 0) return;
        var currentIndex = 0;

        function goToSlide(idx) {
          if (idx < 0) idx = total - 1;
          if (idx >= total) idx = 0;
          currentIndex = idx;

          slides.forEach(function(s, i) {
            if (i === currentIndex) s.classList.add('is-active');
            else s.classList.remove('is-active');
          });

          var thumbStrip = gal.querySelector('.spotlight-thumb-strip');
          thumbs.forEach(function(t, i) {
            var item = t.closest('.spotlight-thumb-item') || t;
            if (i === currentIndex) {
              t.classList.add('is-active');
              if (thumbStrip && item) {
                var targetLeft = item.offsetLeft - (thumbStrip.clientWidth / 2) + (item.clientWidth / 2);
                thumbStrip.scrollTo({ left: targetLeft, behavior: 'smooth' });
              }
            } else {
              t.classList.remove('is-active');
            }
          });

          if (counter) counter.textContent = 'Shot ' + (currentIndex + 1) + ' of ' + total;
          if (progress) progress.style.width = (((currentIndex + 1) / total) * 100) + '%';
        }
        gal._goToSlide = goToSlide;

        if (prevBtn) prevBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          e.preventDefault();
          goToSlide(currentIndex - 1);
        });
        if (nextBtn) nextBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          e.preventDefault();
          goToSlide(currentIndex + 1);
        });

        if (zoomBtn) {
          zoomBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            openLightbox(gal, currentIndex);
          });
        }

        var viewport = gal.querySelector('.spotlight-slides-viewport');
        if (viewport) {
          viewport.addEventListener('click', function(e) {
            if (e.target.closest('.spotlight-nav-btn') || e.target.closest('.spotlight-zoom-trigger')) return;
            openLightbox(gal, currentIndex);
          });
        }

        thumbs.forEach(function(t, i) {
          t.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            goToSlide(i);
          });
        });

        // Touch swipe support
        var startX = 0, startY = 0;
        if (viewport) {
          viewport.addEventListener('touchstart', function(e) {
            if (e.touches && e.touches.length === 1) {
              startX = e.touches[0].clientX;
              startY = e.touches[0].clientY;
            }
          }, { passive: true });
          viewport.addEventListener('touchend', function(e) {
            if (e.changedTouches && e.changedTouches.length === 1) {
              var diffX = e.changedTouches[0].clientX - startX;
              var diffY = e.changedTouches[0].clientY - startY;
              if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
                if (diffX < 0) goToSlide(currentIndex + 1);
                else goToSlide(currentIndex - 1);
              }
            }
          }, { passive: true });
        }

        // Auto rotate
        var autoTimer = null;
        function startAuto() {
          if (autoTimer) clearInterval(autoTimer);
          autoTimer = setInterval(function() {
            var rect = gal.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < (window.innerHeight || document.documentElement.clientHeight)) {
              goToSlide(currentIndex + 1);
            }
          }, 3600);
        }
        startAuto();

        gal.addEventListener('mouseenter', function() { clearInterval(autoTimer); });
        gal.addEventListener('mouseleave', function() { startAuto(); });
      });
    })();

    // Dynamic Product Variants (100g, 250g, 500g) and Quantity Recalculator
    (function initProductVariantsAndQuantity() {
      var cards = document.querySelectorAll('.spotlight-card');
      cards.forEach(function(card) {
        var pills = card.querySelectorAll('.variant-pill');
        var activeDisplay = card.querySelector('.variant-active-display');
        var priceEl = card.querySelector('.spotlight-current-price');
        var mrpEl = card.querySelector('.spotlight-mrp');
        var discountEl = card.querySelector('.spotlight-discount-pill');
        var packInfoEl = card.querySelector('.spotlight-pack-info');
        var minusBtn = card.querySelector('.qty-btn.btn-minus');
        var plusBtn = card.querySelector('.qty-btn.btn-plus');
        var qtyInput = card.querySelector('.qty-input');
        var totalEl = card.querySelector('.spotlight-dynamic-total');
        var breakdownEl = card.querySelector('.breakdown-text');
        var savingsEl = card.querySelector('.total-savings-text');
        var buyBtn = card.querySelector('.btn-spotlight-buy');
        var hiddenVariantInput = card.querySelector('input[name="id"]');
        var hiddenQtyInput = card.querySelector('input[name="quantity"]');

        var currentPrice = 499;
        var currentMrp = 599;
        var currentSize = '250g';
        var quantity = 1;

        // Read initial active pill
        var activePill = card.querySelector('.variant-pill.is-active');
        if (activePill) {
          currentPrice = parseInt(activePill.getAttribute('data-price'), 10) || 499;
          currentMrp = parseInt(activePill.getAttribute('data-mrp'), 10) || 599;
          currentSize = activePill.getAttribute('data-size') || '250g';
        }

        // Save base title for buy button
        if (buyBtn && !buyBtn.getAttribute('data-base-title')) {
          var raw = buyBtn.textContent.replace('→', '').trim();
          var parts = raw.split('&middot;');
          buyBtn.setAttribute('data-base-title', parts[0].trim());
        }

        function updateCalculations() {
          var subtotal = currentPrice * quantity;
          var totalMrp = currentMrp * quantity;
          var savings = totalMrp - subtotal;

          if (priceEl) priceEl.textContent = '₹' + currentPrice;
          if (mrpEl) mrpEl.textContent = '₹' + currentMrp;
          if (qtyInput) qtyInput.value = quantity;
          if (hiddenQtyInput) hiddenQtyInput.value = quantity;
          if (totalEl) totalEl.textContent = '₹' + subtotal.toLocaleString('en-IN');
          if (breakdownEl) breakdownEl.textContent = '₹' + currentPrice + ' × ' + quantity;
          if (savingsEl) {
            if (savings > 0) {
              savingsEl.style.display = 'inline-block';
              savingsEl.textContent = 'Save ₹' + savings.toLocaleString('en-IN');
            } else {
              savingsEl.style.display = 'none';
            }
          }
          if (activeDisplay) activeDisplay.textContent = currentSize + ' (Selected)';

          if (buyBtn) {
            var baseTitle = buyBtn.getAttribute('data-base-title') || 'Buy Now';
            buyBtn.innerHTML = baseTitle + ' &middot; ' + currentSize + ' (' + (quantity > 1 ? quantity + ' × ' : '') + '₹' + subtotal.toLocaleString('en-IN') + ') <span>→</span>';
          }
        }

        pills.forEach(function(pill) {
          pill.addEventListener('click', function(e) {
            e.preventDefault();
            pills.forEach(function(p) {
              p.classList.remove('is-active');
              p.setAttribute('aria-checked', 'false');
            });
            pill.classList.add('is-active');
            pill.setAttribute('aria-checked', 'true');

            currentPrice = parseInt(pill.getAttribute('data-price'), 10);
            currentMrp = parseInt(pill.getAttribute('data-mrp'), 10);
            currentSize = pill.getAttribute('data-size');
            var discountText = pill.getAttribute('data-discount');
            var packText = pill.getAttribute('data-pack');

            if (discountEl && discountText) discountEl.textContent = discountText;
            if (packInfoEl && packText) packInfoEl.textContent = packText;

            updateCalculations();
          });
        });

        if (minusBtn && qtyInput) {
          minusBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (quantity > 1) {
              quantity--;
              updateCalculations();
            }
          });
        }

        if (plusBtn && qtyInput) {
          plusBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (quantity < 50) {
              quantity++;
              updateCalculations();
            }
          });
        }

        updateCalculations();
      });
    })();
  </script>

  <!-- High-Definition Product Lightbox Modal -->
  <div class="tattvva-lightbox" id="productLightbox" role="dialog" aria-modal="true" aria-label="High Definition Product View">
