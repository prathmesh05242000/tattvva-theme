                    <img src="{{ img | image_url: width: 800 }}" alt="{{ roasted_prod.title }} - Shot {{ forloop.index }}" class="spotlight-slide-img" width="520" height="460"{% if forloop.first %} loading="eager"{% else %} loading="lazy"{% endif %}>
                    <span class="spotlight-slide-caption">✦ View {{ forloop.index }} of {{ roasted_prod.images.size }}</span>
