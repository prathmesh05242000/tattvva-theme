              {% else %}
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb is-active" data-slide="0" aria-label="Shot 1: Jar Front"><img src="{{ 'tattvva-dry-fruit-roasted-front.webp' | asset_url }}" width="60" height="60" alt="Jar Front"></button>
