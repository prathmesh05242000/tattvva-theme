                  <img src="{{ 'tattvva-dry-fruit-roasted-front.webp' | asset_url }}" alt="DRY FRUIT MIX - ROASTED - Signature Premium Packaging" class="spotlight-slide-img" width="520" height="460" loading="eager">
                  <span class="spotlight-slide-caption">✦ Signature Premium Packaging</span>
                </div>
                <div class="spotlight-slide" data-index="1" data-caption="Roasted For A Crunchy Bite &middot; Lifestyle" data-full="{{ 'tattvva-dry-fruit-roasted-lifestyle.webp' | asset_url }}">
                  <img src="{{ 'tattvva-dry-fruit-roasted-lifestyle.webp' | asset_url }}" alt="DRY FRUIT MIX - ROASTED - Crunchy Lifestyle Snack" class="spotlight-slide-img" width="520" height="460" loading="lazy">
