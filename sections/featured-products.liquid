<section class="sec products-sec" id="products">
  <div class="products-glow" aria-hidden="true"></div>
  <div class="w">
    
    <!-- Section Header -->
    <div class="products-header">
      <span class="prod-badge">{{ section.settings.kicker | default: '✦ 99.9% Honest Nutrition &middot; Handcrafted Daily' }}</span>
      <h2 class="prod-main-title">{{ section.settings.heading | default: 'Products' }}</h2>
      <p class="prod-main-sub">{{ section.settings.subheading | default: 'Pure superfood creations crafted without preservatives, artificial binders, or refined sugar. Discover our flagship live creation and upcoming kitchen innovations.' }}</p>
    </div>

            <!-- Multi-Product Tab Selector -->
    <div class="prod-selector-wrap">
      <div class="prod-selector-tabs" role="tablist" aria-label="Select a Tattvva Creation">
        <button type="button" class="prod-tab is-active" data-target="prod-laddu" role="tab" aria-selected="true">
          <span class="prod-tab-icon">&#x1F330;</span>
          <span class="prod-tab-text">
            <b>TATTVVA ELITE 21</b>
            <small>Signature Elite-21 &middot; 250g Jar</small>
          </span>
          <span class="prod-tab-badge">Flagship</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-dry-fruit-roasted" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F525;</span>
          <span class="prod-tab-text">
            <b>DRY FRUIT MIX - ROASTED</b>
            <small>Roasted Goodness &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-mix-dry-fruit-raw" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F95C;</span>
          <span class="prod-tab-text">
            <b>MIX DRY FRUIT - RAW</b>
            <small>Power of Five &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-dry-mix-unroasted" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F95D;</span>
          <span class="prod-tab-text">
            <b>DRY FRUIT MIX - WITHOUT ROASTED</b>
            <small>Wholesome Nutrition &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-super-seeds-raw" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F33B;</span>
          <span class="prod-tab-text">
            <b>SUPER SEEDS RAW</b>
            <small>Power of Five &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-super-grain-quinoa" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F33E;</span>
          <span class="prod-tab-text">
            <b>SUPER GRAIN QUINOA</b>
            <small>Natural Nutrition &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
        <button type="button" class="prod-tab" data-target="prod-black-salt" role="tab" aria-selected="false">
          <span class="prod-tab-icon">&#x1F9C2;</span>
          <span class="prod-tab-text">
            <b>BLACK SALT</b>
            <small>The Magic of a Perfect Pinch &middot; Premium Jar</small>
          </span>
          <span class="prod-tab-badge">Live</span>
        </button>
      </div>
    </div>

    <!-- Multi-Product Spotlights Container -->
    <div class="spotlight-products-container">

      <!-- 1. TATTVVA ELITE 21 -->
      {% assign prod_handle = section.settings.product_handle | default: 'premium-dry-fruit-laddu' %}
      {% assign elite_prod = all_products[prod_handle] %}
      <article class="spotlight-card is-active" id="prod-laddu">
        <!-- Left Media Showcase -->
        <div class="spotlight-media-wrap">
          <span class="spotlight-live-tag"><span class="pulse-dot"></span> Live in Store</span>
          <span class="spotlight-edition-tag">★ Flagship Elite-21</span>

          <!-- Interactive Product Slider Gallery -->
          <div class="spotlight-gallery" id="eliteProductGallery" data-auto-play="true">
            <div class="spotlight-slides-viewport">

              {% if elite_prod != blank and elite_prod.images.size > 0 %}
                {% for img in elite_prod.images %}
                  <div class="spotlight-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-caption="View {{ forloop.index }} of {{ elite_prod.images.size }}" data-full="{{ img | image_url: width: 1600 }}">
                    <img src="{{ img | image_url: width: 800 }}" alt="{{ elite_prod.title }} - Shot {{ forloop.index }}" class="spotlight-slide-img" width="520" height="460"{% if forloop.first %} loading="eager"{% else %} loading="lazy"{% endif %}>
                    <span class="spotlight-slide-caption">✦ View {{ forloop.index }} of {{ elite_prod.images.size }}</span>
                  </div>
                {% endfor %}
              {% else %}
                <div class="spotlight-slide is-active" data-index="0" data-caption="Signature Premium Packaging" data-full="{{ 'tattvva-elite-21-front.webp' | asset_url }}">
                  <img src="{{ 'tattvva-elite-21-front.webp' | asset_url }}" alt="TATTVVA ELITE 21 - Signature Premium Packaging" class="spotlight-slide-img" width="520" height="460" loading="eager">
                  <span class="spotlight-slide-caption">✦ Signature Premium Packaging</span>
                </div>
                <div class="spotlight-slide" data-index="1" data-caption="Premium Nut & Dry Fruit Blend" data-full="{{ 'tattvva-elite-21-lifestyle.webp' | asset_url }}">
                  <img src="{{ 'tattvva-elite-21-lifestyle.webp' | asset_url }}" alt="TATTVVA ELITE 21 - Premium Nut & Dry Fruit Blend" class="spotlight-slide-img" width="520" height="460" loading="lazy">
                  <span class="spotlight-slide-caption">✦ Premium Nut &amp; Dry Fruit Blend</span>
                </div>
                <div class="spotlight-slide" data-index="2" data-caption="Packaging & Nutrition Facts" data-full="{{ 'tattvva-elite-21-back.webp' | asset_url }}">
                  <img src="{{ 'tattvva-elite-21-back.webp' | asset_url }}" alt="TATTVVA ELITE 21 - Nutrition Facts & Jar Details" class="spotlight-slide-img" width="520" height="460" loading="lazy">
                  <span class="spotlight-slide-caption">✦ Packaging &amp; Nutrition Facts</span>
                </div>
                <div class="spotlight-slide" data-index="3" data-caption="Certified NABL Nutritional Table" data-full="{{ 'tattvva-elite-21-nutrition.webp' | asset_url }}">
                  <img src="{{ 'tattvva-elite-21-nutrition.webp' | asset_url }}" alt="TATTVVA ELITE 21 - Certified Nutrition Chart" class="spotlight-slide-img" width="520" height="460" loading="lazy">
                  <span class="spotlight-slide-caption">✦ Certified NABL Nutritional Table</span>
                </div>
                <div class="spotlight-slide" data-index="4" data-caption="Complete Product & Packaging Showcase" data-full="{{ 'tattvva-elite-21-showcase.webp' | asset_url }}">
                  <img src="{{ 'tattvva-elite-21-showcase.webp' | asset_url }}" alt="TATTVVA ELITE 21 - Complete Showcase" class="spotlight-slide-img" width="520" height="460" loading="lazy">
                  <span class="spotlight-slide-caption">✦ Complete Product &amp; Packaging Showcase</span>
                </div>
              {% endif %}

              <!-- Navigation Arrows -->
              <button type="button" class="spotlight-nav-btn prev" aria-label="Previous shot">‹</button>
              <button type="button" class="spotlight-nav-btn next" aria-label="Next shot">›</button>
            </div>

            <!-- Running Progress bar & Counter -->
            <div class="spotlight-gallery-footer">
              <div class="spotlight-progress-track">
                <div class="spotlight-progress-fill" style="width: 20%;"></div>
              </div>
              <span class="spotlight-runner-pill"><span class="runner-dot"></span> <span class="runner-counter">Shot 1 of {% if elite_prod != blank and elite_prod.images.size > 0 %}{{ elite_prod.images.size }}{% else %}5{% endif %}</span></span>
            </div>

            <!-- Luxury Thumbnail Strip with Labels -->
            <div class="spotlight-thumb-strip">
              {% if elite_prod != blank and elite_prod.images.size > 0 %}
                {% for img in elite_prod.images %}
                  <div class="spotlight-thumb-item">
                    <button type="button" class="spotlight-thumb{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Shot {{ forloop.index }}"><img src="{{ img | image_url: width: 140 }}" width="60" height="60" alt="Thumbnail {{ forloop.index }}"></button>
                    <span class="spotlight-thumb-label">Shot {{ forloop.index }}</span>
                  </div>
                {% endfor %}
              {% else %}
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb is-active" data-slide="0" aria-label="Shot 1: Jar Front"><img src="{{ 'tattvva-elite-21-front.webp' | asset_url }}" width="60" height="60" alt="Jar Front"></button>
                  <span class="spotlight-thumb-label">Front Jar</span>
                </div>
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb" data-slide="1" aria-label="Shot 2: Lifestyle"><img src="{{ 'tattvva-elite-21-lifestyle.webp' | asset_url }}" width="60" height="60" alt="Lifestyle"></button>
                  <span class="spotlight-thumb-label">Lifestyle</span>
                </div>
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb" data-slide="2" aria-label="Shot 3: Jar Back"><img src="{{ 'tattvva-elite-21-back.webp' | asset_url }}" width="60" height="60" alt="Jar Back"></button>
                  <span class="spotlight-thumb-label">Back Label</span>
                </div>
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb" data-slide="3" aria-label="Shot 4: Nutrition Table"><img src="{{ 'tattvva-elite-21-nutrition.webp' | asset_url }}" width="60" height="60" alt="Nutrition Table"></button>
                  <span class="spotlight-thumb-label">Nutrition</span>
                </div>
                <div class="spotlight-thumb-item">
                  <button type="button" class="spotlight-thumb" data-slide="4" aria-label="Shot 5: Showcase"><img src="{{ 'tattvva-elite-21-showcase.webp' | asset_url }}" width="60" height="60" alt="Showcase"></button>
                  <span class="spotlight-thumb-label">Showcase</span>
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Micro Seals -->
          <div class="spotlight-micro-seals">
            <div class="micro-seal"><span class="micro-seal-icon">&#x1F330;</span><span>21 Whole Nuts &amp; Seeds</span></div>
            <div class="micro-seal"><span class="micro-seal-icon">🍯</span><span>Pure Desi Ghee</span></div>
            <div class="micro-seal"><span class="micro-seal-icon">🌿</span><span>0% Added Sugar or Jaggery</span></div>
          </div>
        </div>

        <!-- Right Product Details -->
        <div class="spotlight-details">
          <div class="spotlight-rating-wrap">
            <span class="spotlight-stars">★★★★★</span>
            <span class="spotlight-verified">4.9 / 5.0</span>
            <span>(500+ verified customer ratings)</span>
          </div>

          <h3 class="spotlight-title">TATTVVA ELITE 21</h3>
          <span class="spotlight-sub-badge">Signature Elite-21 Edition &middot; Premium Packaging</span>

          <p class="spotlight-lead-copy">“A rich combination of premium nuts, seeds, dates and selected natural ingredients, crafted for consumers who appreciate indulgent taste with thoughtfully selected ingredients.”</p>

          <!-- Key Ingredients -->
          <div class="spotlight-ingredients-wrap">
            <div class="spotlight-ingredients-label">Key Ingredients</div>
            <div class="spotlight-ingredients-pills">
              <span class="ing-pill"><span class="ing-pill-dot"></span>Almond</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Cashew</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Walnut</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Pistachio</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Pecan</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Macadamia</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Brazil Nut</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Dates</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Anjeer</span>
              <span class="ing-pill"><span class="ing-pill-dot"></span>Seeds</span>
            </div>
          </div>

          <div class="spotlight-highlights-label">Product Highlights</div>
          <div class="spotlight-highlights-grid">
            <div class="hl-card">
              <div class="hl-card-icon">🧁</div>
              <div class="hl-card-title">Rich taste</div>
              <p class="hl-card-desc">Indulgent melt-in-mouth richness from Iranian pistachios, cashews, and Arabian dates. Zero bitter aftertaste.</p>
            </div>
            <div class="hl-card">
              <div class="hl-card-icon">⚡</div>
              <div class="hl-card-title">Thoughtfully crafted</div>
              <p class="hl-card-desc">A rich combination of premium nuts, seeds, dates and natural ingredients for wholesome indulgence.</p>
            </div>
            <div class="hl-card">
              <div class="hl-card-icon">🌿</div>
              <div class="hl-card-title">Where Goodness Begins</div>
              <p class="hl-card-desc">At Tattvva, we believe that great food begins with thoughtfully selected ingredients.</p>
            </div>
          </div>

          <!-- Size / Weight Selection (100g, 250g, 500g) -->
          <div class="product-variant-selector">
            <div class="variant-selector-header">
              <span class="variant-label">Select Net Weight:</span>
              <span class="variant-active-display">250g (Selected)</span>
            </div>
            <div class="variant-pill-group" role="radiogroup" aria-label="Select Weight">
              <button type="button" class="variant-pill" data-size="100g" data-price="249" data-mrp="299" data-discount="Save 17% OFF" data-pack="Net Wt: 100g (Trial / Snacking Size &middot; 3–4 Laddus) &middot; Freshness Sealed &middot; Incl. of all taxes" role="radio" aria-checked="false">
                <span class="pill-weight">100g</span>
                <span class="pill-badge">Trial Pack</span>
                <span class="pill-price">₹249</span>
              </button>
              <button type="button" class="variant-pill is-active" data-size="250g" data-price="499" data-mrp="599" data-discount="Save 17% OFF" data-pack="Net Wt: 250g (8–10 Artisanal Laddus) &middot; Sealed Freshness Premium Packaging &middot; Incl. of all taxes" role="radio" aria-checked="true">
                <span class="pill-weight">250g</span>
                <span class="pill-badge best-seller">Most Popular</span>
                <span class="pill-price">₹499</span>
              </button>
              <button type="button" class="variant-pill" data-size="500g" data-price="949" data-mrp="1199" data-discount="Save 21% OFF" data-pack="Net Wt: 500g (Family Value Pack &middot; 16–20 Laddus) &middot; Sealed Freshness &middot; Incl. of all taxes" role="radio" aria-checked="false">
                <span class="pill-weight">500g</span>
                <span class="pill-badge value-save">Save 21%</span>
                <span class="pill-price">₹949</span>
              </button>
            </div>
          </div>

          <div class="spotlight-price-box">
            <span class="spotlight-current-price">{% if elite_prod.price %}{{ elite_prod.price | money }}{% else %}₹499{% endif %}</span>
            <span class="spotlight-mrp">{% if elite_prod.compare_at_price %}{{ elite_prod.compare_at_price | money }}{% else %}₹599{% endif %}</span>
            <span class="spotlight-discount-pill">Save 17% OFF</span>
            <div class="spotlight-pack-info">Net Wt: 250g (8–10 Artisanal Laddus) &middot; Sealed Freshness Premium Packaging &middot; Inclusive of all taxes</div>
          </div>

          <!-- Quantity Stepper & Dynamic Total Subtotal -->
          <div class="product-qty-row">
            <div class="qty-control-wrapper">
              <span class="qty-label">Quantity:</span>
              <div class="qty-stepper">
                <button type="button" class="qty-btn btn-minus" aria-label="Decrease quantity">−</button>
                <input type="number" class="qty-input" value="1" min="1" max="50" aria-label="Product quantity" readonly>
                <button type="button" class="qty-btn btn-plus" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <div class="price-summary-dynamic">
              <div class="total-price-line">
                <span class="total-label">Subtotal:</span>
                <span class="spotlight-dynamic-total">₹499</span>
              </div>
              <div class="total-unit-breakdown">
                <span class="breakdown-text">₹499 × 1</span>
                <span class="total-savings-text">Save ₹100</span>
              </div>
            </div>
          </div>

          <div class="spotlight-action-row">
            <a href="{{ elite_prod.url | default: '/products/premium-dry-fruit-laddu' }}" class="btn-spotlight-buy">Buy Now &middot; Elite-21 <span>→</span></a>
            {% if elite_prod.selected_or_first_available_variant %}
              <form method="post" action="{{ routes.cart_add_url }}" style="flex:1;">
                <input type="hidden" name="id" value="{{ elite_prod.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn-spotlight-cart" style="width:100%;"><span>🛒</span> Add to Bag</button>
              </form>
            {% else %}
              <a href="{{ elite_prod.url | default: '/products/premium-dry-fruit-laddu' }}" class="btn-spotlight-cart"><span>🛒</span> Add to Bag</a>
            {% endif %}
          </div>

          <div class="spotlight-trust-list">
            <span>✓ Free Pan-India Delivery</span>
            <span>✓ Dispatched in 24h</span>
            <span>✓ FSSAI Certified Sterile Kitchen</span>
          </div>
        </div>
      </article>

      <!-- 2. DRY FRUIT MIX - ROASTED -->
      {% assign roasted_prod = all_products['dry-fruit-mix-roasted'] %}
      <article class="spotlight-card" id="prod-dry-fruit-roasted">
        <!-- Left Media Showcase -->
        <div class="spotlight-media-wrap">
