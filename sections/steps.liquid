<section class="quality-journey-sec" id="quality">
  <!-- Subtle Ambient Radial Glow -->
  <div class="qj-ambient-glow" aria-hidden="true"></div>

  <div class="w">
    
    <!-- Section Header -->
    <div class="qj-header">
      <div class="qj-kicker-wrap">
        <span class="qj-beacon" aria-hidden="true"></span>
        <span class="qj-kicker">UNCOMPROMISING PURITY &middot; 8-STAGE ARTISAN PROTOCOL</span>
      </div>
      <h2 class="qj-title">From Raw Harvest to <span class="qj-title-hl">Your Doorstep</span></h2>
      <p class="qj-subtitle">We believe true quality is not an inspection step at the end—it is an unbroken chain of custody. Zero chemical processing, FSSAI-certified micro-batching, and uncompromising food safety standards.</p>

      <!-- Quick Metrics Ribbon -->
      <div class="qj-metrics-bar">
        <div class="qj-m-item">
          <span class="qj-m-num">99.9%</span>
          <span class="qj-m-lbl">Batch Traceable</span>
        </div>
        <div class="qj-m-div"></div>
        <div class="qj-m-item">
          <span class="qj-m-num">0%</span>
          <span class="qj-m-lbl">Chemical Extraction</span>
        </div>
        <div class="qj-m-div"></div>
        <div class="qj-m-item">
          <span class="qj-m-num">8</span>
          <span class="qj-m-lbl">Artisan Checkpoints</span>
        </div>
        <div class="qj-m-div"></div>
        <div class="qj-m-item">
          <span class="qj-m-num">&lt; 75°C</span>
          <span class="qj-m-lbl">Gentle Roasting</span>
        </div>
      </div>
    </div>

    <!-- INTERACTIVE 8-STEP HORIZONTAL PIPELINE TRACK -->
    <div class="qj-pipeline-wrap">
      <div class="qj-pipeline-track" role="tablist">
        <!-- Connecting Energy Line -->
        <div class="qj-track-line">
          <div class="qj-track-fill" id="qjTrackFill" style="width: 12.5%;"></div>
        </div>

        
          <button class="qj-node-btn is-active" data-index="0" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">🌿</span>
              <span class="qj-node-num">01</span>
            </div>
            <span class="qj-node-title">Direct Sourcing</span>
          </button>
        
          <button class="qj-node-btn " data-index="1" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">💧</span>
              <span class="qj-node-num">02</span>
            </div>
            <span class="qj-node-title">Sonic Cleaning</span>
          </button>
        
          <button class="qj-node-btn " data-index="2" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">&#x1F525;</span>
              <span class="qj-node-num">03</span>
            </div>
            <span class="qj-node-title">Slow Roasting</span>
          </button>
        
          <button class="qj-node-btn " data-index="3" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">🍯</span>
              <span class="qj-node-num">04</span>
            </div>
            <span class="qj-node-title">Natural Blending</span>
          </button>
        
          <button class="qj-node-btn " data-index="4" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">✋</span>
              <span class="qj-node-num">05</span>
            </div>
            <span class="qj-node-title">Artisan Handcrafting</span>
          </button>
        
          <button class="qj-node-btn " data-index="5" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">🔬</span>
              <span class="qj-node-num">06</span>
            </div>
            <span class="qj-node-title">Quality &amp; Lab Validation</span>
          </button>
        
          <button class="qj-node-btn " data-index="6" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">❄️</span>
              <span class="qj-node-num">07</span>
            </div>
            <span class="qj-node-title">Freshness Preservation</span>
          </button>
        
          <button class="qj-node-btn " data-index="7" type="button" role="tab">
            <div class="qj-node-circle">
              <span class="qj-node-icon">🏺</span>
              <span class="qj-node-num">08</span>
            </div>
            <span class="qj-node-title">Premium Packaging</span>
          </button>
        
      </div>
    </div>

    <!-- THE DYNAMIC STAGE SPOTLIGHT THEATER -->
    <div class="qj-theater" id="qjTheater">
      <!-- Big Translucent Architectural Watermark -->
      <div class="qj-watermark-num" id="qjWatermarkNum">01</div>

      <div class="qj-theater-grid">
        
        <!-- Left: Stage Visual & Status Card -->
        <div class="qj-stage-visual-col">
          <div class="qj-orb-stage">
            <div class="qj-orb-aura" aria-hidden="true"></div>
            <div class="qj-stage-icon-orb" id="qjStageIconOrb">
              🌿
            </div>
          </div>
          
          <div class="qj-phase-badge" id="qjPhaseBadge">
            <span class="qj-phase-dot"></span>
            <span id="qjKickerText">STAGE 01 OF 08 &middot; FARM CUSTODY</span>
          </div>

          <div class="qj-metric-chip" id="qjMetricChip">
            <span id="qjMetricText">📍 Trusted Growers & Suppliers &middot; 99.9% Traceable</span>
          </div>

          <!-- Step Progression Progress Bar -->
          <div class="qj-step-meter">
            <div class="qj-step-meter-head">
              <span id="qjStepCounter">STEP 1 OF 8</span>
              <span id="qjPercentText">12.5% COMPLETE</span>
            </div>
            <div class="qj-step-meter-bar">
              <div class="qj-step-meter-fill" id="qjStepMeterFill" style="width: 12.5%;"></div>
            </div>
          </div>
        </div>

        <!-- Right: Stage Deep-Dive & Checkpoints -->
        <div class="qj-stage-content-col">
          <h3 class="qj-stage-title" id="qjStageTitle">Direct Sourcing</h3>
          
          <p class="qj-stage-desc" id="qjStageDesc">Carefully select premium dates, dry fruits, nuts, seeds, and natural ingredients directly from trusted growers and suppliers. Ensure authenticity, freshness, and traceability.</p>

          <!-- Checkpoints Shelf -->
          <div class="qj-checkpoints-card">
            <div class="qj-cp-header">
              <span>CRITICAL QUALITY CONTROLS</span>
              <span class="qj-cp-verified">✓ FSSAI VERIFIED</span>
            </div>
            <ul class="qj-cp-list" id="qjCheckpointsList">
                <li>
                  <span class="qj-cp-chk">✓</span>
                  <span>Premium dates, dry fruits, nuts, seeds & natural ingredients</span>
                </li>
                <li>
                  <span class="qj-cp-chk">✓</span>
                  <span>Direct procurement from trusted regional growers and ethical suppliers</span>
                </li>
                <li>
                  <span class="qj-cp-chk">✓</span>
                  <span>Rigorous verification ensuring authenticity, peak freshness & traceability</span>
                </li>
            </ul>
          </div>

          <!-- Interactive Step Navigation Toolbar -->
          <div class="qj-nav-row">
            <button class="qj-nav-btn qj-prev-btn" id="qjPrevBtn" type="button" aria-label="Previous Stage" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>Previous Stage</span>
            </button>

            <!-- Auto-Advance Toggle -->
            <button class="qj-auto-btn" id="qjAutoBtn" type="button" title="Toggle Auto Tour">
              <span class="qj-play-icon">▶</span>
              <span>Auto Tour</span>
            </button>

            <button class="qj-nav-btn qj-next-btn" id="qjNextBtn" type="button" aria-label="Next Stage">
              <span>Next Stage</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>

        </div>

      </div>
    </div>

    <!-- THE 5 STANDARDS & REGISTRATION CERTIFICATION RIBBON -->
    <div class="qj-standards-ribbon">
      <div class="qj-std-item">
        <div class="qj-std-icon">
          <img src="{{ 'cert-msme.svg' | asset_url }}" alt="Certified as MSME" width="36" height="36" loading="lazy">
        </div>
        <div>
          <b class="qj-std-title">Certified as MSME</b>
          <p class="qj-std-no"><b>under Udhyam No-MH-33-0778675</b></p>
        </div>
      </div>
      <div class="qj-std-item">
        <div class="qj-std-icon">
          <img src="{{ 'cert-fssai.webp' | asset_url }}" alt="Certified under FSSAI" width="36" height="36" loading="lazy">
        </div>
        <div>
          <b class="qj-std-title">Certified under FSSAI</b>
          <p class="qj-std-no"><b>No-21526021003329</b></p>
        </div>
      </div>
      <div class="qj-std-item">
        <div class="qj-std-icon">
          <img src="{{ 'cert-gst.webp' | asset_url }}" alt="GST Complied" width="36" height="36" loading="lazy">
        </div>
        <div>
          <b class="qj-std-title">GST Complied</b>
          <p class="qj-std-no"><b>Under No-27ABKPI8952J1Z3</b></p>
        </div>
      </div>
      <div class="qj-std-item">
        <div class="qj-std-icon">
          <img src="{{ 'cert-zed.webp' | asset_url }}" alt="Certified under MSME ZeD" width="36" height="36" loading="lazy">
        </div>
        <div>
          <b class="qj-std-title">Certified under MSME ZeD</b>
          <p class="qj-std-no"><b>No-926177</b></p>
        </div>
      </div>
      <div class="qj-std-item">
        <div class="qj-std-icon">
          <img src="{{ 'cert-ptec.svg' | asset_url }}" alt="Registered Under PTEC_RC" width="36" height="36" loading="lazy">
        </div>
        <div>
          <b class="qj-std-title">Registered Under PTEC_RC</b>
          <p class="qj-std-no"><b>No.99273123019P</b></p>
        </div>
      </div>
    </div>

  </div>

  <!-- Interactive JavaScript Logic -->
  <script>
    (function(){
      var stages = [
        {
          "id": "stage-1",
          "num": "01",
          "icon": "🌿",
          "shortName": "Direct Sourcing",
          "kicker": "STAGE 01 OF 08 &middot; FARM CUSTODY",
          "title": "Direct Sourcing",
          "metric": "📍 Trusted Growers & Suppliers &middot; 99.9% Traceable",
          "desc": "Carefully select premium dates, dry fruits, nuts, seeds, and natural ingredients directly from trusted growers and suppliers. Ensure authenticity, freshness, and traceability.",
          "checkpoints": [
            "Premium dates, dry fruits, nuts, seeds & natural ingredients",
            "Direct procurement from trusted regional growers and ethical suppliers",
            "Rigorous verification ensuring authenticity, peak freshness & traceability"
          ],
          "accentColor": "#C9972B"
        },
        {
          "id": "stage-2",
          "num": "02",
          "icon": "💧",
          "shortName": "Sonic Cleaning",
          "kicker": "STAGE 02 OF 08 &middot; PURITY PROTOCOL",
          "title": "Sonic Cleaning",
          "metric": "🔍 Advanced Dry Purity &middot; Zero Chemical Treatment",
          "desc": "Advanced cleaning process removes dust, impurities, and foreign particles while preserving natural nutrients. Maintains hygiene standards without chemical treatment.",
          "checkpoints": [
            "Advanced multi-tier process removes dust, impurities & foreign particles",
            "Preserves delicate natural nutrients, essential enzymes & minerals",
            "Maintains uncompromising global hygiene standards with zero chemicals"
          ],
          "accentColor": "#54B352"
        },
        {
          "id": "stage-3",
          "num": "03",
          "icon": "&#x1F525;",
          "shortName": "Slow Roasting",
          "kicker": "STAGE 03 OF 08 &middot; ARTISAN ROAST",
          "title": "Slow Roasting",
          "metric": "⏱️ Calibrated Heat &middot; Aroma & Texture Enhanced",
          "desc": "Nuts and seeds are gently roasted at controlled temperatures. Enhances flavor, aroma, texture, and natural richness.",
          "checkpoints": [
            "Nuts and seeds gently roasted at calibrated, controlled temperatures",
            "Evaporates excess moisture while awakening rich natural nutty oils",
            "Significantly enhances flavor, golden aroma, crisp texture & richness"
          ],
          "accentColor": "#E5A81A"
        },
        {
          "id": "stage-4",
          "num": "04",
          "icon": "🍯",
          "shortName": "Natural Blending",
          "kicker": "STAGE 04 OF 08 &middot; CLEAN RECIPE",
          "title": "Natural Blending & Compounding",
          "metric": "🍯 0% Sugar &middot; 0% Jaggery &middot; 0% Preservatives",
          "desc": "Premium ingredients are blended in precise ratios. No refined sugar, jaggery, preservatives, artificial flavors, or additives. Creates the signature Tattvva taste and nutrition profile.",
          "checkpoints": [
            "Carefully sourced premium ingredients blended in precise, wholesome ratios",
            "Zero refined sugar, zero jaggery, zero preservatives & no artificial additives",
            "Creates the signature TATTVVA® taste, sustained energy & nutrition profile"
          ],
          "accentColor": "#8E2F6A"
        },
        {
          "id": "stage-5",
          "num": "05",
          "icon": "✋",
          "shortName": "Artisan Handcrafting",
          "kicker": "STAGE 05 OF 08 &middot; SMALL BATCH CRAFT",
          "title": "Artisan Handcrafting",
          "metric": "✨ Skilled Small-Batch Craft &middot; Whole Nut Crunch",
          "desc": "Skilled artisans carefully shape dry fruit snacks in small batches. Ensures consistency, premium quality, and handcrafted excellence.",
          "checkpoints": [
            "Skilled artisans carefully shape dry fruit snacks in small micro-batches",
            "Ensures batch consistency, uncompromised premium quality & artisanal care",
            "Handcrafted excellence preserving intact whole-nut textures and mouthfeel"
          ],
          "accentColor": "#C9972B"
        },
        {
          "id": "stage-6",
          "num": "06",
          "icon": "🔬",
          "shortName": "Quality & Lab Validation",
          "kicker": "STAGE 06 OF 08 &middot; LAB COMPLIANCE",
          "title": "Quality & Lab Validation",
          "metric": "📋 FSSAI Schedule-IV Compliant &middot; Batch Testing",
          "desc": "Batch-wise testing for quality, food safety, nutritional compliance, and consistency. Adheres to stringent manufacturing standards.",
          "checkpoints": [
            "Batch-wise laboratory testing for quality, purity & sensory consistency",
            "Full food safety compliance and certified nutritional profile verification",
            "Strictly adheres to stringent national and international manufacturing norms"
          ],
          "accentColor": "#54B352"
        },
        {
          "id": "stage-7",
          "num": "07",
          "icon": "❄️",
          "shortName": "Freshness Preservation",
          "kicker": "STAGE 07 OF 08 &middot; OPTIMAL SHELF LIFE",
          "title": "Freshness Preservation",
          "metric": "🛡️ Moisture Calibrated &middot; Natural Goodness Intact",
          "desc": "Products undergo moisture and freshness checks. Ensures optimal shelf life while maintaining natural goodness.",
          "checkpoints": [
            "Every finished batch undergoes rigorous moisture and freshness audits",
            "Ensures optimal shelf life stability while maintaining pure natural goodness",
            "Locks in natural aroma, crispness and nutritional potency without additives"
          ],
          "accentColor": "#2F6B2E"
        },
        {
          "id": "stage-8",
          "num": "08",
          "icon": "🏺",
          "shortName": "Premium Packaging",
          "kicker": "STAGE 08 OF 08 &middot; ELEGANT FINISH",
          "title": "Premium Packaging",
          "metric": "🔒 FSSAI Approved &middot; Gifting-Ready Luxury",
          "desc": "Packed in elegant, FSSAI approved premium-grade packaging designed for freshness, gifting, and superior customer experience. Reflects Tattvva's premium yet natural brand identity.",
          "checkpoints": [
            "Packed in elegant, FSSAI-approved premium food-grade packaging",
            "Specifically designed for prolonged freshness, gifting & superior experience",
            "Reflects TATTVVA's premium, authentic, and naturally pure brand identity"
          ],
          "accentColor": "#5E1D47"
        }
      ];
      var currentIndex = 0;
      var autoPlaying = false;
      var autoTimer = null;

      var nodes = document.querySelectorAll('.qj-node-btn');
      var trackFill = document.getElementById('qjTrackFill');
      var theater = document.getElementById('qjTheater');
      
      var watermark = document.getElementById('qjWatermarkNum');
      var orb = document.getElementById('qjStageIconOrb');
      var kicker = document.getElementById('qjKickerText');
      var metric = document.getElementById('qjMetricText');
      var counter = document.getElementById('qjStepCounter');
      var pctText = document.getElementById('qjPercentText');
      var meterFill = document.getElementById('qjStepMeterFill');
      var title = document.getElementById('qjStageTitle');
      var desc = document.getElementById('qjStageDesc');
      var cpList = document.getElementById('qjCheckpointsList');
      var prevBtn = document.getElementById('qjPrevBtn');
      var nextBtn = document.getElementById('qjNextBtn');
      var autoBtn = document.getElementById('qjAutoBtn');

      function renderStage(idx) {
        if(idx < 0 || idx >= stages.length) return;
        currentIndex = idx;
        var s = stages[idx];

        // Pulse theater animation
        theater.classList.remove('qj-pulse');
        void theater.offsetWidth;
        theater.classList.add('qj-pulse');

        // Update active node
        nodes.forEach(function(n, i){
          if(i === idx) n.classList.add('is-active');
          else n.classList.remove('is-active');
        });

        // Pipeline track progress calculation
        var pct = ((idx + 1) / stages.length) * 100;
        trackFill.style.width = pct + '%';
        meterFill.style.width = pct + '%';

        // Update textual contents
        watermark.textContent = s.num;
        orb.textContent = s.icon;
        kicker.textContent = s.kicker;
        metric.textContent = s.metric;
        counter.textContent = 'STEP ' + (idx + 1) + ' OF ' + stages.length;
        pctText.textContent = pct.toFixed(1) + '% COMPLETE';
        title.textContent = s.title;
        desc.textContent = s.desc;

        // Checkpoints list
        cpList.innerHTML = s.checkpoints.map(function(c){
          return '<li><span class="qj-cp-chk">✓</span><span>' + c + '</span></li>';
        }).join('');

        // Navigation buttons state
        prevBtn.disabled = (idx === 0);
        nextBtn.disabled = (idx === stages.length - 1);
      }

      // Node clicks
      nodes.forEach(function(btn){
        btn.addEventListener('click', function(){
          stopAuto();
          var idx = parseInt(this.getAttribute('data-index'), 10);
          renderStage(idx);
        });
      });

      // Prev / Next clicks
      prevBtn.addEventListener('click', function(){
        stopAuto();
        if(currentIndex > 0) renderStage(currentIndex - 1);
      });
      nextBtn.addEventListener('click', function(){
        stopAuto();
        if(currentIndex < stages.length - 1) renderStage(currentIndex + 1);
      });

      // Auto Tour logic
      function startAuto() {
        autoPlaying = true;
        autoBtn.classList.add('is-playing');
        autoBtn.innerHTML = '<span class="qj-play-icon">⏸</span><span>Pause Tour</span>';
        autoTimer = setInterval(function(){
          var next = (currentIndex + 1) % stages.length;
          renderStage(next);
        }, 4000);
      }

      function stopAuto() {
        if(!autoPlaying) return;
        autoPlaying = false;
        clearInterval(autoTimer);
        autoBtn.classList.remove('is-playing');
        autoBtn.innerHTML = '<span class="qj-play-icon">▶</span><span>Auto Tour</span>';
      }

      autoBtn.addEventListener('click', function(){
        if(autoPlaying) stopAuto();
        else startAuto();
      });

    })();
  </script>
</section>

{% schema %}
{
  "name": "Quality Journey",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Eyebrow",
      "default": "UNCOMPROMISING PURITY &middot; 8-STAGE ARTISAN PROTOCOL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Raw Harvest to Your Doorstep"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We believe true quality is not an inspection step at the end—it is an unbroken chain of custody. Zero chemical processing, FSSAI-certified micro-batching, and uncompromising food safety standards."
    }
  ],
  "presets": [
    {
      "name": "Quality Journey"
    }
  ]
}
{% endschema %}
