      var pills = document.querySelectorAll('.sf-pill-btn');
      var stage = document.getElementById('sfSpotlightStage');
      var bgVisual = document.getElementById('sfStageBgVisual');
      var orbAura = document.getElementById('sfOrbAura');
      var heroImg = document.getElementById('sfHeroImg');
      var bioHighlight = document.getElementById('sfBioHighlightText');
      
      var watermark = document.getElementById('sfWatermarkNum');
      var catBadge = document.getElementById('sfCatBadge');
      var indexTag = document.getElementById('sfIndexTag');
      var itemName = document.getElementById('sfItemName');
      var originText = document.getElementById('sfOriginText');
      var itemDesc = document.getElementById('sfItemDesc');
      
      var m1Label = document.getElementById('sfM1Label');
      var m1Val = document.getElementById('sfM1Val');
      var m1Fill = document.getElementById('sfM1Fill');

      var m2Label = document.getElementById('sfM2Label');
      var m2Val = document.getElementById('sfM2Val');
      var m2Fill = document.getElementById('sfM2Fill');

      var m3Label = document.getElementById('sfM3Label');
      var m3Val = document.getElementById('sfM3Val');
      var m3Fill = document.getElementById('sfM3Fill');

      var tagsCluster = document.getElementById('sfTagsCluster');

      var assetBase = (stage && stage.getAttribute('data-asset-base')) || 'assets/';

      function updateSpotlight(item) {
        if(!item) return;

        // Stage pulse & image crossfade
        stage.classList.remove('sf-stage-transition');
        void stage.offsetWidth; // trigger reflow
        stage.classList.add('sf-stage-transition');

        if(heroImg) {
          heroImg.classList.add('is-updating');
          setTimeout(function(){
            heroImg.src = assetBase + item.image;
            heroImg.alt = item.name;
            heroImg.classList.remove('is-updating');
          }, 120);
        }

        if(bgVisual) {
          bgVisual.style.backgroundImage = "url('" + (assetBase + item.image) + "')";
        }

        if(orbAura && item.accent) {
          orbAura.style.background = 'radial-gradient(circle, ' + item.accent + '66 0%, rgba(142,47,106,0.25) 50%, transparent 70%)';
        }

        if(bioHighlight && item.highlight) {
          bioHighlight.textContent = item.highlight;
        }

        watermark.textContent = item.num;
        catBadge.textContent = item.catLabel;
        indexTag.textContent = 'SUPERFOOD ' + item.num + ' OF 21';
        itemName.textContent = item.name;
        originText.textContent = item.origin;
        itemDesc.textContent = item.desc;

        m1Label.textContent = item.meters[0].label;
        m1Val.textContent = item.meters[0].val + '%';
        m1Fill.style.width = item.meters[0].val + '%';
        m1Fill.style.background = item.meters[0].color;

        m2Label.textContent = item.meters[1].label;
        m2Val.textContent = item.meters[1].val + '%';
        m2Fill.style.width = item.meters[1].val + '%';
        m2Fill.style.background = item.meters[1].color;

        m3Label.textContent = item.meters[2].label;
        m3Val.textContent = item.meters[2].val + '%';
        m3Fill.style.width = item.meters[2].val + '%';
        m3Fill.style.background = item.meters[2].color;

        tagsCluster.innerHTML = item.tags.map(function(t){
          return '<span class="sf-micro-tag">✦ ' + t + '</span>';
        }).join('');
      }

      pills.forEach(function(btn){
        btn.addEventListener('click', function(){
          pills.forEach(function(b){ b.classList.remove('is-selected'); });
          this.classList.add('is-selected');
          var id = this.getAttribute('data-id');
          var item = data.find(function(d){ return d.id === id; });
          updateSpotlight(item);
        });
      });
    })();
  </script>
</section>

