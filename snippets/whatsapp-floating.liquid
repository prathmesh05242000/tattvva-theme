<!-- WhatsApp Floating Click to Chat Button -->
<style>
.tattvva-whatsapp-float {
  position: fixed;
  bottom: 28px;
  right: 24px;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
}

.tattvva-whatsapp-float:hover {
  transform: translateY(-4px) scale(1.06);
  filter: drop-shadow(0 10px 22px rgba(37, 211, 102, 0.45));
}

.tattvva-whatsapp-float:active {
  transform: translateY(-1px) scale(0.98);
}

.tattvva-whatsapp-btn {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45), 0 3px 8px rgba(0, 0, 0, 0.15);
  position: relative;
  transition: box-shadow 0.25s ease;
}

.tattvva-whatsapp-pulse {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #25D366;
  opacity: 0.6;
  animation: wa-pulse-wave 2.2s infinite ease-out;
  pointer-events: none;
  z-index: -1;
}

@keyframes wa-pulse-wave {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    opacity: 0.25;
  }
  100% {
    transform: scale(1.55);
    opacity: 0;
  }
}

.tattvva-whatsapp-icon {
  width: 32px;
  height: 32px;
  fill: #ffffff;
  display: block;
}

@media(max-width: 640px) {
  .tattvva-whatsapp-float {
    bottom: 20px;
    right: 18px;
  }
  .tattvva-whatsapp-btn {
    width: 52px;
    height: 52px;
  }
  .tattvva-whatsapp-icon {
    width: 28px;
    height: 28px;
  }
}
</style>

<a href="https://wa.me/917666642112?text=Hello%20Tattvva%20Team%2C%20I%20have%20an%20inquiry%20about%20your%20products." 
