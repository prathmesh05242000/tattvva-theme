{% comment %}
  Tattvva Clean Nutrition - Advanced SEO & Social Sharing Metadata
  Optimized for Google, Bing, Facebook/Meta, X/Twitter, WhatsApp, and LinkedIn
{% endcomment %}

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="format-detection" content="telephone=no, address=no, email=no">
<meta name="theme-color" content="#5E1D47">
<meta name="msapplication-TileColor" content="#5E1D47">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Tattvva">

{% assign page_seo_title = page_title | default: shop.name %}
{% unless page_seo_title contains shop.name %}
  {% assign page_seo_title = page_seo_title | append: ' &middot; Tattvva Pure Nutrition' %}
{% endunless %}

{% assign page_seo_description = page_description | default: "Tattvva crafts 100% honest superfood nutrition with zero compromises. 21 pure superfoods, traditional Desi ghee, zero refined white sugar, zero preservatives. Certified FSSAI, MSME & NABL lab-tested." | escape %}

<!-- Open Graph / Meta Protocol -->
<meta property="og:site_name" content="{{ shop.name | default: 'Tattvva - The Pure Essence of Nutrition' }}">
<meta property="og:url" content="{{ canonical_url | default: shop.url }}">
<meta property="og:title" content="{{ page_seo_title | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ page_seo_description }}">
<meta property="og:locale" content="{{ request.locale.iso_code | default: 'en_IN' }}">

{% if page_image %}
  <meta property="og:image" content="{{ page_image | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:secure_url" content="{{ page_image | image_url: width: 1200, height: 630 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ page_seo_title | escape }}">
{% else %}
  <meta property="og:image" content="{{ 'tattvva-elite-21-front.webp' | asset_url }}">
  <meta property="og:image:secure_url" content="{{ 'tattvva-elite-21-front.webp' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  <meta property="og:image:alt" content="Tattvva 21 Superfood Handcrafted Nutrition">
{% endif %}

<!-- Twitter Card Protocol -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_seo_title | escape }}">
<meta name="twitter:description" content="{{ page_seo_description }}">
{% if page_image %}
  <meta name="twitter:image" content="{{ page_image | image_url: width: 1200, height: 630 }}">
{% else %}
  <meta name="twitter:image" content="{{ 'tattvva-elite-21-front.webp' | asset_url }}">
{% endif %}

<!-- Mobile PWA & Touch Icons -->
<link rel="apple-touch-icon" href="{{ 'tattvva-logo.webp' | asset_url }}">
