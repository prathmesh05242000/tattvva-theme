<!-- Tattvva Luxury Back to Top Floating Button (Left Side) -->
<style>
.tattvva-btt-float {
  position: fixed;
  bottom: 28px;
  left: 24px;
  z-index: 99998;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(16px) scale(0.92);
  transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
              visibility 0.35s ease,
              filter 0.25s ease;
  background: none;
  border: none;
  padding: 0;
}

.tattvva-btt-float.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}

.tattvva-btt-float:hover {
  transform: translateY(-4px) scale(1.06);
  filter: drop-shadow(0 10px 24px rgba(58, 13, 40, 0.45));
}

.tattvva-btt-float:active {
  transform: translateY(-1px) scale(0.96);
}

.tattvva-btt-btn {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: linear-gradient(135deg, #3A0D28 0%, #5E1D47 100%);
  border: 1.5px solid rgba(201, 151, 43, 0.45);
  box-shadow: 0 8px 24px rgba(58, 13, 40, 0.28), 0 2px 8px rgba(201, 151, 43, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.tattvva-btt-float:hover .tattvva-btt-btn {
  border-color: #FFD100;
  box-shadow: 0 12px 28px rgba(58, 13, 40, 0.4), 0 0 16px rgba(255, 209, 0, 0.3);
}

/* SVG Scroll Progress Ring */
.tattvva-btt-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
  pointer-events: none;
}

.tattvva-btt-ring-bg {
  stroke: rgba(201, 151, 43, 0.2);
}

.tattvva-btt-ring-fill {
  stroke: #FFD100;
  stroke-dasharray: 157.08; /* 2 * PI * 25 */
  stroke-dashoffset: 157.08;
  transition: stroke-dashoffset 0.15s ease-out;
}

.tattvva-btt-icon {
  width: 22px;
  height: 22px;
  color: #FFD100;
  display: block;
  position: relative;
  z-index: 2;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
}

.tattvva-btt-float:hover .tattvva-btt-icon {
  transform: translateY(-3px);
  color: #FFFFFF;
}

/* Tooltip on Desktop */
.tattvva-btt-tooltip {
  position: absolute;
  left: calc(100% + 12px);
  background: rgba(58, 13, 40, 0.94);
  color: #FFF9E6;
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 5px 11px;
  border-radius: 99px;
  border: 1px solid rgba(201, 151, 43, 0.4);
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transform: translateX(-6px);
  transition: all 0.22s ease;
  pointer-events: none;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.tattvva-btt-float:hover .tattvva-btt-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
}

@media (max-width: 640px) {
  .tattvva-btt-float {
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    left: 18px;
  }
  .tattvva-btt-btn {
    width: 48px;
    height: 48px;
  }
  .tattvva-btt-icon {
    width: 20px;
    height: 20px;
  }
  .tattvva-btt-tooltip {
    display: none !important;
  }
}
</style>

<button type="button" 
        id="tattvvaBackToTop" 
        class="tattvva-btt-float" 
        aria-label="Back to top" 
        title="Back to top">
  <div class="tattvva-btt-btn">
    <svg class="tattvva-btt-ring" viewBox="0 0 56 56" aria-hidden="true">
      <circle class="tattvva-btt-ring-bg" cx="28" cy="28" r="25" fill="none" stroke-width="2.5" />
      <circle class="tattvva-btt-ring-fill" id="tattvvaBttRingFill" cx="28" cy="28" r="25" fill="none" stroke-width="2.5" stroke-linecap="round" />
    </svg>
    <svg class="tattvva-btt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    <span class="tattvva-btt-tooltip">Back to top</span>
  </div>
</button>

<script>
(function() {
  var bttBtn = document.getElementById('tattvvaBackToTop');
  var bttFill = document.getElementById('tattvvaBttRingFill');
  if (!bttBtn) return;

  var circumference = 157.08; // 2 * Math.PI * 25
  var isVisible = false;
  var ticking = false;

  function updateBackToTop() {
    var scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
    var docHeight = Math.max(
      document.body.scrollHeight, document.documentElement.scrollHeight,
      document.body.offsetHeight, document.documentElement.offsetHeight
    );
    var winHeight = window.innerHeight || document.documentElement.clientHeight || 1;
    var maxScroll = Math.max(1, docHeight - winHeight);
    var progress = Math.min(1, Math.max(0, scrollTop / maxScroll));

    // Update progress ring stroke
    if (bttFill) {
      var offset = circumference - (progress * circumference);
      bttFill.style.strokeDashoffset = offset;
    }

    // Toggle visibility based on 300px scroll threshold
    if (scrollTop > 300) {
      if (!isVisible) {
        bttBtn.classList.add('is-visible');
        isVisible = true;
      }
    } else {
      if (isVisible) {
        bttBtn.classList.remove('is-visible');
        isVisible = false;
      }
    }
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateBackToTop);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  // Initial check
  updateBackToTop();

  // Smooth scroll to top on click
  bttBtn.addEventListener('click', function(e) {
    e.preventDefault();
    if (window.lenis && typeof window.lenis.scrollTo === 'function') {
      window.lenis.scrollTo(0, { duration: 1.2 });
    } else {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }
  });
})();
</script>
